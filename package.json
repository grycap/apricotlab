{
    "name": "apricot",
    "version": "1.1.1",
    "description": "Advanced Platform for Reproducible Infrastructure in the Cloud via Open Tools.",
    "keywords": [
        "jupyter",
        "jupyterlab",
        "jupyterlab-extension"
    ],
    "homepage": "https://github.com/grycap/apricotlab",
    "bugs": {
        "url": "https://github.com/grycap/apricotlab/issues"
    },
    "license": "BSD-3-Clause",
    "author": {
        "name": "Antonio Sanchez",
        "email": "asanchez@i3m.upv.es"
    },
    "files": [
        "lib/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf}",
        "style/**/*.{css,js,eot,gif,html,jpg,json,png,svg,woff2,ttf}",
        "src/**/*.{ts,tsx}",
        "resources/**/*"
    ],
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "style": "style/index.css",
    "repository": {
        "type": "git",
        "url": "https://github.com/grycap/apricotlab.git"
    },
    "scripts": {
        "build": "yarn build:lib && yarn build:labextension:dev",
        "build:prod": "yarn clean && yarn build:lib:prod && yarn build:labextension",
        "build:labextension": "jupyter labextension build . && yarn copy:resources",
        "build:labextension:dev": "jupyter labextension build --development True . && yarn copy:resources",
        "copy:resources": "node -e \"const fs=require('fs');fs.rmSync('apricot/labextension/resources',{recursive:true,force:true});fs.cpSync('resources','apricot/labextension/resources',{recursive:true});\"",
        "build:lib": "tsc --sourceMap",
        "build:lib:prod": "tsc",
        "clean": "yarn clean:lib",
        "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
        "clean:lintcache": "rimraf .eslintcache .stylelintcache",
        "clean:labextension": "rimraf apricot/labextension apricot/_version.py",
        "clean:all": "yarn clean:lib && yarn clean:labextension && yarn clean:lintcache",
        "eslint": "yarn eslint:check --fix",
        "eslint:check": "eslint . --cache",
        "install:extension": "yarn build",
        "lint": "yarn stylelint && yarn prettier && yarn eslint",
        "lint:check": "yarn stylelint:check && yarn prettier:check && yarn eslint:check",
        "prettier": "yarn prettier:base --write --list-different",
        "prettier:base": "prettier \"**/*{.ts,.tsx,.js,.jsx,.css,.json,.md}\"",
        "prettier:check": "yarn prettier:base --check",
        "stylelint": "yarn stylelint:check --fix",
        "stylelint:check": "stylelint --cache \"style/**/*.css\"",
        "test": "yarn test:unit",
        "test:unit": "jest --runInBand",
        "watch": "yarn watch:src & yarn watch:labextension",
        "watch:src": "tsc -w --sourceMap",
        "watch:labextension": "jupyter labextension watch ."
    },
    "dependencies": {
        "@jupyterlab/application": "^4.5.11",
        "@jupyterlab/apputils": "^4.6.11",
        "@jupyterlab/docregistry": "^4.5.11",
        "@jupyterlab/notebook": "^4.5.11",
        "@jupyterlab/services": "^7.5.11",
        "@jupyterlab/ui-components": "^4.5.11",
        "@lumino/disposable": "^2.1.5",
        "@lumino/widgets": "^2.7.5",
        "js-yaml": "^4.3.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@jupyterlab/builder": "^4.5.11",
        "@types/jest": "^29.5.14",
        "@types/js-yaml": "^4.0.9",
        "@types/react": "^18.3.0",
        "@typescript-eslint/eslint-plugin": "^8.56.0",
        "@typescript-eslint/parser": "^8.56.0",
        "css-loader": "^7.1.2",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "globals": "^13.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "prettier": "^3.3.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "rimraf": "^6.0.1",
        "source-map-loader": "^5.0.0",
        "style-loader": "^4.0.0",
        "stylelint": "^15.10.1",
        "stylelint-config-recommended": "^13.0.0",
        "stylelint-config-standard": "^34.0.0",
        "stylelint-csstree-validator": "^3.0.0",
        "stylelint-prettier": "^4.0.0",
        "ts-jest": "^29.4.15",
        "typescript": "^5.7.2",
        "webpack": "5.104.1",
        "yjs": "^13.6.24"
    },
    "sideEffects": [
        "style/*.css",
        "style/index.js"
    ],
    "styleModule": "style/index.js",
    "publishConfig": {
        "access": "public"
    },
    "jupyterlab": {
        "extension": true,
        "outputDir": "apricot/labextension"
    },
    "prettier": {
        "singleQuote": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "endOfLine": "lf",
        "overrides": [
            {
                "files": "package.json",
                "options": {
                    "tabWidth": 4
                }
            }
        ]
    },
    "stylelint": {
        "extends": [
            "stylelint-config-recommended",
            "stylelint-config-standard",
            "stylelint-prettier/recommended"
        ],
        "plugins": [
            "stylelint-csstree-validator"
        ],
        "rules": {
            "csstree/validator": true,
            "property-no-vendor-prefix": null,
            "selector-class-pattern": "^([a-z][A-z\\d]*)(-[A-z\\d]+)*$",
            "selector-no-vendor-prefix": null,
            "value-no-vendor-prefix": null
        }
    },
    "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
    "resolutions": {
        "flatted": "3.4.2",
        "lodash": "4.18.1",
        "lodash-es": "4.18.1",
        "minimatch@npm:^3.0.4": "3.1.5",
        "minimatch@npm:^3.1.1": "3.1.5",
        "minimatch@npm:^3.1.2": "3.1.5",
        "picomatch@npm:^2.2.3": "2.3.2",
        "picomatch@npm:^2.3.1": "2.3.2",
        "@lumino/widgets": "2.10.0",
        "dompurify": "3.4.17",
        "ajv@npm:^6.12.4": "6.14.0",
        "ajv@npm:^6.12.5": "6.14.0"
    }
}
